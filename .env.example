# Copy to .env and edit. Both Next and Compose read that filename, so one file
# configures the development server and the container stack. Never commit it.

# Postgres. Matches compose.yaml.
DATABASE_URL=postgres://cooking:cooking@localhost:5432/cooking

# The role the application connects as at runtime. NOT the owner role, so
# row-level security actually applies. Created by the domain migration.
APP_DATABASE_URL=postgres://cooking_app:cooking_app@localhost:5432/cooking

# Two more databases sit beside the one above, so nothing automated writes into
# the database you develop against. `npm run db:setup` creates both, and both
# default to the URLs above with a suffix appended, so leave these unset unless
# they live somewhere else.
#
# For each pair: set both or neither, since they are the owner and runtime roles
# of one database and must name the same one; keep the suffix, which is what
# stops the three databases being crossed; and use the same password as
# APP_DATABASE_URL, because cooking_app is one role for the whole instance.

# What `npm test` runs against. The suite truncates every table in it on the way
# in, so it refuses to run against a name not ending in _test.
# TEST_DATABASE_URL=postgres://cooking:cooking@localhost:5432/cooking_test
# TEST_APP_DATABASE_URL=postgres://cooking_app:cooking_app@localhost:5432/cooking_test

# What `npm run dev:test` serves, and therefore what `npm run verify:oauth`
# writes into. Its own, and not the suite's: that server holds sessions and
# OAuth consents for as long as it runs, and the suite empties what it truncates.
# VERIFY_DATABASE_URL=postgres://cooking:cooking@localhost:5432/cooking_verify
# VERIFY_APP_DATABASE_URL=postgres://cooking_app:cooking_app@localhost:5432/cooking_verify

# Where `npm run dev:test` serves and `npm run verify:oauth` looks. Loopback
# only, and not 3000, because dev:test empties the allowlist and turns password
# sign-in on: together that is an unauthenticated sign-up door.
# DEV_TEST_PORT=3100

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# Canonical MCP protected-resource identifier (RFC 8707 / RFC 9728).
# HTTPS in production. HTTP is accepted only on loopback hosts.
MCP_RESOURCE=http://localhost:3000/api/mcp

# Google sign-in. Create an OAuth client of type "Web application" in the Google
# Cloud console and give it the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may hold an account, comma separated, matched exactly after lowercasing.
# Google sign-in only proves an address, this is what grants access. Empty is
# open in development and closed in production, so a production instance with no
# list refuses everyone rather than accepting anyone.
ALLOWED_EMAILS=

# Development only, and commented out on purpose. Opens the email and password
# endpoints on the auth API. No screen offers it and there is no sign-up page.
#
# `npm run verify:oauth` does not need this: `npm run dev:test` sets the flag
# for the server it starts, which is the only server that script drives, so the
# value here has no bearing on that flow.
#
# What it does do, when it is on together with an empty ALLOWED_EMAILS above, is
# open an unauthenticated sign-up door: anyone who can reach the port can create
# an account. `npm run dev` binds to 127.0.0.1 so that door is at least not on
# the network, and dev:test does the same for the same reason. Turn it on only
# when you have a use for it, and never in production. The `serve` profile in
# compose.yaml does not pass it through at all, so a container cannot open it.
# AUTH_PASSWORD_LOGIN=true

# ---------------------------------------------------------------------------
# Deployment. Only the container stack reads what follows, and only under
# `docker compose --profile serve`. Ignore all of it when running from source.
# Everything above still applies, with two values that have to change:
#
#   BETTER_AUTH_URL=https://cuisine.example.com
#   MCP_RESOURCE=https://cuisine.example.com/api/mcp
#
# AUTH_PASSWORD_LOGIN used to be a third. It is commented out above now, and
# the `serve` profile does not pass it through in any case.
#
# The two DATABASE_URL lines are the exception: compose builds its own from the
# credentials below and points them at the `db` service, so the localhost values
# above are used only from source.
# ---------------------------------------------------------------------------

# Postgres credentials for the container. Change the password before the machine
# has a public address on it. Changing it after the first start does not rotate
# anything: the volume already holds the initialised cluster, and the role has
# to be altered by hand.
#
# **Both passwords must be URL-safe.** Compose builds DATABASE_URL and
# APP_DATABASE_URL out of them by string substitution and has no way to
# percent-encode a value, so a password containing `/`, `@`, `#`, `%` or `:`
# produces a URL that parses to a different host or a different database. What
# you get is the migrator failing with something that reads like a wrong
# password, which sends you looking at the credential rather than at its shape.
#
# `openssl rand -base64 24` produces one of those characters most of the time.
# Generate them with hex instead, which cannot:
#
#   openssl rand -hex 24
#
# `npm run db:bootstrap` checks the database name its URL parses to against
# POSTGRES_DB before it connects, so a password that got this wrong is named as
# such rather than surfacing as a stack trace.
# POSTGRES_USER=cooking
# POSTGRES_PASSWORD=
# POSTGRES_DB=cooking

# The runtime role's password. `npm run db:bootstrap` reads it out of
# APP_DATABASE_URL, which compose assembles from this, so setting it here is
# enough and it does not belong in two places. URL-safe, for the reason above.
# APP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Credentials as files, instead of as container environment. Optional, and
# entirely additive: everything above keeps working untouched if you skip this.
#
# A value in a service's `environment:` block is readable with `docker inspect`,
# by every process in that container, and through /proc/1/environ. Four values
# on this stack are worth keeping out of all three, and both halves of the stack
# can read a file instead: the Postgres image supports POSTGRES_PASSWORD_FILE
# natively, and `secret()` in src/lib/config.ts prefers `<NAME>_FILE` over
# `<NAME>` for every secret the application reads.
#
# Set the paths here, then add the overlay that mounts them:
#
#   COMPOSE_FILE=compose.yaml:deploy/compose.secrets.yaml
#
# deploy/compose.secrets.yaml has the setup commands and explains why the two
# database ones are the whole URL rather than the password. That is also the way
# out of the URL-safety constraint above: a URL written into a file by hand is
# encoded once, by whoever knows what the password is, and Compose never builds
# it.
# BETTER_AUTH_SECRET_FILE=/etc/cooking-app/better_auth_secret
# GOOGLE_CLIENT_SECRET_FILE=/etc/cooking-app/google_client_secret
# POSTGRES_PASSWORD_FILE=/etc/cooking-app/postgres_password
# DATABASE_URL_FILE=/etc/cooking-app/database_url
# APP_DATABASE_URL_FILE=/etc/cooking-app/app_database_url
# ---------------------------------------------------------------------------

# `deploy/compose.proxy.yaml` only. The hostname Caddy gets a certificate for,
# which is the same host as BETTER_AUTH_URL and MCP_RESOURCE, without the
# scheme. The email is optional and only decides whether the certificate
# authority can warn you before an expiry.
# APP_DOMAIN=cuisine.example.com
# ACME_EMAIL=

# Which build to run. CI publishes two tags per commit: a moving `main-*`, which
# is the default, and an immutable `sha-<commit>-*`. Setting this to one of the
# latter is the whole rollback procedure, and it needs no revert and no rebuild.
#
#   IMAGE_TAG=sha-1a2b3c4
#
# IMAGE_REPO is for a fork: point it at your own registry and the stack deploys
# from your builds instead. The package is private, so a server needs
# `docker login ghcr.io` first, with a token scoped to read:packages and nothing
# else. Section 2.1 of docs/08-self-hosting.md has that step.
# IMAGE_TAG=main
# IMAGE_REPO=ghcr.io/lsrageux/cooking-app

# scripts/backup.sh. Defaults match compose.yaml, so both are optional.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# Set to `podman-compose` on a machine without Docker.
# COMPOSE_CMD=docker compose
