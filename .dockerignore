# Everything the build does not need. Keeping .env out is the important line:
# the image must take its configuration at runtime, not carry a copy of someone's
# secret into a layer.
.env
.env.*
.git
.github
.next
# `npm run dev:test` builds here, and `npm run test:coverage` reports here.
# Neither is build input, and both are large enough to slow every build on a
# machine that has run them once.
.next-test
coverage
node_modules
npm-debug.log*
tsconfig.tsbuildinfo
*.md
docs
tests

# Operator territory, not build input. deploy/ is bind-mounted by compose at
# run time, and backups/ holds database dumps.
backups
deploy
