{
  "name": "cooking-app",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": "^26.3.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "podman compose up -d db",
    "db:down": "podman compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:deps": "node scripts/check-no-llm-deps.mjs",
    "verify": "npm run check:deps && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:oauth": "node scripts/verify-oauth-flow.mjs",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "auth:migrate": "tsx scripts/auth-migrate.ts",
    "db:setup": "npm run db:up && npm run db:bootstrap && npm run db:migrate && npm run auth:migrate && npm run db:setup:test && npm run db:setup:verify",
    "db:setup:test": "node scripts/db-setup-sibling.mjs test",
    "db:setup:verify": "node scripts/db-setup-sibling.mjs verify",
    "dev:test": "node scripts/dev-test-server.mjs",
    "backup": "sh scripts/backup.sh"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.2",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "linkedom": "^0.18.13",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "intl-messageformat": "^11.2.14",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
